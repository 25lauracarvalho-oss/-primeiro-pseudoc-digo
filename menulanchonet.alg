algoritmo "Menulanchonet"

var
 opcao: inteiro

inicio 
 escreval(" 1 - Hamburguer | 2 - Pizza | 3 - Salada")
 leia(opcao)
 
 escolha opcao
    caso 1
      escreval("Preparando o Hamburguer...")
    caso 2
      escreval("Assando a Pizza...")
     caso 3
      escreval("Cortando a Salada...")
 fimescolha

fimalgoritmo